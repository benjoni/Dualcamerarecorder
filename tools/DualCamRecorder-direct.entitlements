<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: DeckLinkAPI.framework (/Library/Frameworks) is signed by Blackmagic, not by us,
	     so library validation has to be off for the app to load the driver API. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Hardened Runtime: without this the audio interface (Focusrite …) is silently refused – no access
	     prompt, no entry in Privacy & Security → Microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
